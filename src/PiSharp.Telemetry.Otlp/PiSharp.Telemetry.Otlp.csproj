<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RootNamespace>PiSharp.Telemetry.Otlp</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PiSharp.Telemetry.Otlp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiSharp.Compatibility\PiSharp.Compatibility.csproj" />
    <ProjectReference Include="..\PiSharp.Extensions\PiSharp.Extensions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The OpenTelemetry SDK is referenced only here (plan §3.3): the core emits
      OTel-native via ActivitySource("PiSharp") / Meter("PiSharp") in the BCL,
      and this plugin attaches the OTLP exporters to those sources.
    -->
    <PackageReference Include="OpenTelemetry" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
  </ItemGroup>

</Project>
