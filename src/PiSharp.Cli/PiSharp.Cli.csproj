<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <RootNamespace>PiSharp.Cli</RootNamespace>
    <RunModelCatalogGenerationOnBuild Condition="'$(RunModelCatalogGenerationOnBuild)' == ''">true</RunModelCatalogGenerationOnBuild>
    <ModelCatalogGeneratorProject>$(MSBuildThisFileDirectory)..\PiSharp.Ai.ModelGenerator\PiSharp.Ai.ModelGenerator.csproj</ModelCatalogGeneratorProject>
    <ModelCatalogOutputPath>$(MSBuildThisFileDirectory)..\PiSharp.Ai\Models\Generated\BuiltInModels.g.cs</ModelCatalogOutputPath>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>pisharp</ToolCommandName>
    <PackageOutputPath>./nupkg</PackageOutputPath>
    <PackageId>PiSharp.Cli</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai;agent;cli;tui;coding-agent;llm;anthropic</PackageTags>
    <Description>PiSharp is a C#/.NET coding agent CLI and Terminal UI — a port of the Pi coding agent supporting Anthropic, OpenAI, Gemini, and more.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PiSharp.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.8" />
    <ProjectReference Include="..\PiSharp.Runtime\PiSharp.Runtime.csproj" />
    <ProjectReference Include="..\PiSharp.Tui\PiSharp.Tui.csproj" />
    <ProjectReference Include="..\PiSharp.Packages\PiSharp.Packages.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <Target Name="GenerateModelCatalog" BeforeTargets="BeforeBuild" Condition="'$(RunModelCatalogGenerationOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <Message Importance="high" Text="Generating built-in model/provider catalog" />
    <Exec Command="dotnet run --project &quot;$(ModelCatalogGeneratorProject)&quot; -- &quot;$(ModelCatalogOutputPath)&quot;" />
  </Target>

</Project>
