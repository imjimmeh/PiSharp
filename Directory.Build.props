<Project>
  <PropertyGroup>
    <Authors>Jimmeh</Authors>
    <Copyright>Copyright © 2026 Jimmeh</Copyright>
    <PackageProjectUrl>https://github.com/imjimmeh/PiSharpio</PackageProjectUrl>
    <RepositoryUrl>https://github.com/imjimmeh/PiSharpio</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Default dev version; release workflow overrides with -p:Version=X.Y.Z -->
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <!-- Keep assembly identity stable so installed native extensions can bind across package builds. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>
</Project>
